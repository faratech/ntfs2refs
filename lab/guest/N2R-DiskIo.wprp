<?xml version="1.0" encoding="utf-8"?>
<!-- Research profile only. No trace is started by installing this file.
     Memory mode can wrap; retained start/end markers and loss checks are mandatory. -->
<WindowsPerformanceRecorder Version="1.0">
  <Profiles>
    <SystemCollector Id="N2RSystem" Name="N2R bounded disk IO">
      <BufferSize Value="64" />
      <Buffers Value="128" />
    </SystemCollector>
    <EventCollector Id="N2REvents" Name="N2R trace markers">
      <BufferSize Value="64" />
      <Buffers Value="16" />
    </EventCollector>
    <SystemProvider Id="N2RDiskProvider">
      <Keywords>
        <Keyword Value="CpuConfig" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
        <Keyword Value="SplitIO" />
      </Keywords>
    </SystemProvider>
    <EventProvider Id="N2RRecorderControl" Name="36b6f488-aad7-48c2-afe3-d4ec2c8b46fa" NonPagedMemory="true">
      <Keywords><Keyword Value="0x10000" /></Keywords>
    </EventProvider>
    <EventProvider Id="N2RMarker" Name="b7a19fcd-15ba-41ba-a3d7-dc352d5f79ba" NonPagedMemory="true" Strict="true" />
    <EventProvider Id="N2RTraceState" Name="b675ec37-bdb6-4648-bc92-f3fdc74d3ca2" NonPagedMemory="true" Level="15">
      <Keywords><Keyword Value="0x40" /></Keywords>
    </EventProvider>
    <Profile Id="N2RDiskIO.Light.Memory" Name="N2RDiskIO" Description="Bounded guest disk-I/O measurement; no zero-copy qualification" LoggingMode="Memory" DetailLevel="Light">
      <Collectors>
        <SystemCollectorId Value="N2RSystem"><SystemProviderId Value="N2RDiskProvider" /></SystemCollectorId>
        <EventCollectorId Value="N2REvents">
          <EventProviders>
            <EventProviderId Value="N2RRecorderControl" />
            <EventProviderId Value="N2RMarker" />
            <EventProviderId Value="N2RTraceState" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
